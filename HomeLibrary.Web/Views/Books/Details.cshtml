@model HomeLibrary.Application.Books.Dtos.BookDto
@{
    ViewData["Title"] = Model.Title;
}

<h1>@Model.Title</h1>

<dl class="row">
    <dt class="col-sm-2">Автор</dt>
    <dd class="col-sm-10">@Model.Author</dd>
    <dt class="col-sm-2">Год</dt>
    <dd class="col-sm-10">@Model.PublishYear</dd>
    <dt class="col-sm-2">Издательство</dt>
    <dd class="col-sm-10">@Model.Publisher</dd>
    <dt class="col-sm-2">ISBN</dt>
    <dd class="col-sm-10">@Model.ISBN</dd>
    <dt class="col-sm-2">Страниц</dt>
    <dd class="col-sm-10">@Model.Pages</dd>
</dl>

<h3>Оглавление</h3>
<div class="border p-3">
    @if (string.IsNullOrWhiteSpace(Model.Contents))
    {
        <p class="text-muted">Оглавление не заполнено.</p>
    }
    else
    {
        @Html.Raw(Model.Contents)
    }
</div>

<a asp-action="Edit" asp-route-id="@Model.BookId" class="btn btn-primary">Редактировать</a>
<a asp-action="Index" class="btn btn-secondary">Назад</a>